    "ai": "6.0.190",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "pnpm --dir ../../../../ --filter @nimiplatform/sdk build && node ../../../../scripts/build-typescript-package.mjs --tsconfig tsconfig.build.json --out-dir dist",
