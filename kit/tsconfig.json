{
  "compilerOptions": {
    "paths": {
      "@nimiplatform/kit/ui": ["./ui/src/index.ts"],
      "@nimiplatform/kit/ui/*": ["./ui/src/*"],
      "@nimiplatform/kit/auth": ["./auth/src/index.ts"],
      "@nimiplatform/kit/auth/*": ["./auth/src/*"],
      "@nimiplatform/kit/core/*": ["./core/src/*"],
      "@nimiplatform/kit/telemetry": ["./telemetry/src/telemetry/index.ts"],
      "@nimiplatform/kit/telemetry/*": ["./telemetry/src/*"],
      "@nimiplatform/kit/features/avatar": ["./features/avatar/src/index.ts"],
      "@nimiplatform/kit/features/avatar/*": ["./features/avatar/src/*"],
      "@nimiplatform/kit/features/chat": ["./features/chat/src/index.ts"],
      "@nimiplatform/kit/features/chat/*": ["./features/chat/src/*"],
      "@nimiplatform/kit/features/commerce": ["./features/commerce/src/index.ts"],
      "@nimiplatform/kit/features/commerce/*": ["./features/commerce/src/*"],
      "@nimiplatform/kit/features/generation": ["./features/generation/src/index.ts"],
      "@nimiplatform/kit/features/generation/*": ["./features/generation/src/*"],
      "@nimiplatform/kit/shell/renderer/*": ["./shell/renderer/src/*"],
      "@nimiplatform/kit/shell/capabilities": ["./shell/capabilities/src/index.ts"],
      "@nimiplatform/kit/shell/capabilities/*": ["./shell/capabilities/src/*"],
      "@nimiplatform/kit/shell/electron/main": ["./shell/electron/src/main/index.ts"],
      "@nimiplatform/kit/shell/electron/preload": ["./shell/electron/src/preload/index.ts"],
      "@nimiplatform/kit/shell/electron/preload-cjs": ["./shell/electron/src/preload/cjs.cts"],
      "@nimiplatform/kit/shell/electron/*": ["./shell/electron/src/*"],
      "@nimiplatform/kit/core/runtime-capabilities": ["./core/src/runtime-capabilities/index.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "ui/src/**/*.ts",
    "ui/src/**/*.tsx",
    "ui/src/**/*.d.ts",
    "ui/test/**/*.ts",
    "ui/test/**/*.tsx",
    "preview/src/**/*.ts",
    "preview/src/**/*.tsx",
    "preview/vite.config.ts",
    "auth/src/**/*.ts",
    "auth/src/**/*.tsx",
    "auth/src/**/*.d.ts",
    "core/src/**/*.ts",
    "features/**/*.ts",
    "features/**/*.tsx",
    "telemetry/src/**/*.ts",
    "telemetry/src/**/*.tsx",
    "telemetry/src/**/*.d.ts",
    "shell/renderer/src/**/*.ts",
    "shell/renderer/src/**/*.tsx",
    "shell/renderer/test/host-contract.typecheck.ts",
    "shell/capabilities/src/**/*.ts",
    "shell/electron/src/**/*.ts",
    "shell/electron/src/**/*.cts"
  ]
}
