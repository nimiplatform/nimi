        "lineHeight": 1.5,
        "fontWeight": 400,
        "letterSpacing": 0
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "\"Inter\", \"Noto Sans SC\", \"Source Han Sans SC\", \"PingFang SC\", \"Microsoft YaHei UI\", \"Segoe UI\", system-ui, sans-serif",
