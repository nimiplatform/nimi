        "lineHeight": "2.5rem",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "\"Inter\", \"Noto Sans SC\", \"Source Han Sans SC\", \"PingFang SC\", \"Microsoft YaHei UI\", \"Segoe UI\", system-ui, sans-serif",
        "fontSize": "0.9375rem",
        "lineHeight": 1.25,
        "fontWeight": 600,
        "letterSpacing": 0
