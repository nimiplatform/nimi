    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "\"JetBrains Mono\", \"SF Mono\", \"Fira Code\", ui-monospace, monospace",
        "fontSize": "0.8125rem",
        "lineHeight": 1.4,
        "fontWeight": 500,
        "letterSpacing": 0
      }
