{
  "name": "@nimiplatform/app-tools",
  "version": "0.13.1",
  "description": "Public app-authoring CLI for Nimi App projects.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nimiplatform/nimi",
    "directory": "app-tools"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nimiScaffoldVersions": {
    "sdkVersion": "^0.21.0",
    "appToolsVersion": "^0.13.1",
    "nimicodingVersion": "0.6.5",
    "aiSdkVersion": "^6.0.85",
    "kitVersion": "^0.21.0",
    "reactVersion": "^19.3.0",
    "reactDomVersion": "^19.3.0",
    "i18nextVersion": "^26.4.2",
    "lucideReactVersion": "^1.51.0",
    "tsxVersion": "^4.23.15",
    "typescriptVersion": "^6.0.3",
    "nodeTypesVersion": "^24.19.1",
    "reactTypesVersion": "^19.3.0",
    "reactDomTypesVersion": "^19.3.0",
    "viteVersion": "^8.3.3",
    "viteReactPluginVersion": "^6.1.2",
    "tailwindcssVersion": "^4.3.3",
    "tailwindcssViteVersion": "^4.3.3",
    "tauriCliVersion": "^2.11.4",
    "yamlVersion": "^2.9.1",
    "nimiShellTauriVersion": "0.10.0",
    "electronPackagerVersion": "^20.3.0",
    "electronVersion": "^44.5.1",
    "esbuildVersion": "^0.28.2",
    "packageManager": "pnpm@10.34.5"
  },
  "bin": {
    "nimi-app": "./bin/nimi-app.mjs"
  },
  "exports": {},
  "scripts": {
    "build": "node scripts/sync-scaffold-versions.mjs --apply && node scripts/sync-app-source.mjs --apply",
    "sync:versions": "node scripts/sync-scaffold-versions.mjs --apply",
    "sync:app-source": "node scripts/sync-app-source.mjs --apply",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "node ../scripts/with-workspace-surfaces.mjs -- pnpm run test:prepared",
    "test:large-archive": "node --test test/app-pack-large.test.mjs",
    "test:prepared": "node scripts/sync-scaffold-versions.mjs --check && node --test test/dev-shell.test.mjs && node --test test/app-dependency-combinations.test.mjs test/app-safety-profile.test.mjs test/app-project-lifecycle.test.mjs test/app-pack.test.mjs test/app-pack-large.test.mjs test/app-scaffold.test.mjs"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "templates",
    "skills",
    "README.md"
  ],
  "dependencies": {
    "pngjs": "7.0.0",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vite": "8.3.4",
    "i18next": "26.4.3"
  }
}
