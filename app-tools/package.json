{
  "name": "@nimiplatform/app-tools",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nimiplatform/nimi",
    "directory": "app-tools"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "nimi-app": "./bin/nimi-app.mjs"
  },
  "exports": {
    "./simulator-conformance": "./lib/simulator-conformance.mjs",
    "./simulator-css-profile": "./lib/simulator-css-profile.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-simulator-effect-policy.mjs --check && node scripts/sync-app-source.mjs --apply",
    "sync:app-source": "node scripts/sync-app-source.mjs --apply",
    "prepack": "node scripts/generate-simulator-effect-policy.mjs --check && node scripts/sync-app-source.mjs --apply",
    "prepublishOnly": "node scripts/generate-simulator-effect-policy.mjs --check && node scripts/sync-app-source.mjs --apply",
    "check:simulator-effect-policy": "node scripts/generate-simulator-effect-policy.mjs --check",
    "test": "node scripts/generate-simulator-effect-policy.mjs --check && node ../scripts/with-workspace-surfaces.mjs -- node --test test/*.test.mjs"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "templates",
    "README.md"
  ],
  "dependencies": {
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
