import { useEffect, useMemo, useState } from 'react';
import { InlineAlert, NimiTabs, StatusBadge, Surface } from '@nimiplatform/kit/ui';
import { testerCapabilities, getTesterCapability, type TesterCapabilityId } from './tester-capabilities.js';
import { appendTesterRunHistory } from './tester-history.js';
import { loadTesterAIConfigSummary, type TesterAIConfigSummary } from './tester-ai-config.js';
import type { TesterCapabilityRunResult } from './tester-runtime.js';
import { testerTestIds } from './tester-test-ids.js';
import { KitComponentGallery } from './kit-component-gallery.js';
import { TextGeneratePanel } from './panels/text-generate-panel.js';
import { TextEmbedPanel } from './panels/text-embed-panel.js';
import { ChatPanel } from './panels/chat-panel.js';
import { ImagePanel } from './panels/image-panel.js';
import { AudioPanel } from './panels/audio-panel.js';
import { VideoPanel } from './panels/video-panel.js';
import { SpeechBundlePanel } from './panels/speech-bundle-panel.js';
import { WorldTourPanel } from './panels/world-tour-panel.js';

const initialCapabilityId: TesterCapabilityId = 'text.generate';
type TesterWorkspaceTab = 'workflows' | 'components';

const workspaceTabs = [
  { value: 'workflows', label: 'AI workflows' },
  { value: 'components', label: 'Kit components' },
];

type TesterWorkbenchProps = {
  title: string;
};

function makeRecordId() {
  return `run-${Date.now().toString(36)}`;
}

export function TesterWorkbench({ title }: TesterWorkbenchProps) {
  const [workspaceTab, setWorkspaceTab] = useState<TesterWorkspaceTab>('workflows');
  const [activeId, setActiveId] = useState<TesterCapabilityId>(initialCapabilityId);
  const [summary, setSummary] = useState<TesterAIConfigSummary | null>(null);
  const [historyError, setHistoryError] = useState<string | null>(null);
  const capability = useMemo(() => getTesterCapability(activeId), [activeId]);

  useEffect(() => {
    void loadTesterAIConfigSummary().then(setSummary).catch((error) => {
      setSummary({
        runtime: {
          status: 'unavailable',
          mode: 'unknown',
          detail: error instanceof Error ? error.message : String(error || 'Runtime inspection failed.'),
        },
        schedulingOwner: 'runtime',
        providerCatalogSurface: 'runtimeAdmin.listProviderCatalog',
        appLocalProviderDefaults: false,
      });
    });
  }, []);

  async function onResult(result: TesterCapabilityRunResult, prompt: string) {
    await appendTesterRunHistory({
      id: makeRecordId(),
      capabilityId: result.capabilityId,
      prompt,
      status: result.ok ? 'ready' : 'unavailable',
      message: result.ok ? result.message : result.message,
      createdAt: new Date().toISOString(),
    }).catch((error) => setHistoryError(error instanceof Error ? error.message : String(error || 'History persistence failed.')));
  }

  function renderPanel() {
    const props = { capability, onResult };
    if (activeId === 'text.generate') return <TextGeneratePanel {...props} />;
    if (activeId === 'chat.stream') return <ChatPanel {...props} />;
    if (activeId === 'text.embed') return <TextEmbedPanel {...props} />;
    if (activeId === 'image.generate') return <ImagePanel {...props} />;
    if (activeId === 'video.generate') return <VideoPanel {...props} />;
    if (activeId === 'audio.synthesize' || activeId === 'audio.transcribe') return <AudioPanel {...props} />;
    if (activeId === 'speech.bundle') return <SpeechBundlePanel {...props} />;
    return <WorldTourPanel {...props} />;
  }

  return (
    <section className="product-area tester-workbench" data-testid={testerTestIds.root}>
      <div className="product-hero tester-hero">
        <div>
          <p className="eyebrow">Nimi App Runtime Tester</p>
          <h1 id="product-title">{title}</h1>
          <p className="product-copy">A first-party developer app for Runtime readiness, SDK surface gaps, app-owned Tauri commands, and Nimi Kit glass UI acceptance.</p>
        </div>
        <StatusBadge tone="info" shape="dot">developer-only</StatusBadge>
      </div>

      <Surface className="tester-workspace-tabs" material="glass-thin" tone="panel">
        <NimiTabs
          items={workspaceTabs}
          value={workspaceTab}
          onValueChange={(value) => setWorkspaceTab(value as TesterWorkspaceTab)}
          ariaLabel="Nimi tester workspace"
        />
      </Surface>

      {workspaceTab === 'components' ? <KitComponentGallery /> : null}

      {workspaceTab === 'workflows' ? (
        <div className="tester-layout">
          <Surface className="tester-nav" material="glass-regular" tone="panel" elevation="raised" data-testid={testerTestIds.capabilityNav}>
            {testerCapabilities.map((item) => (
              <button
                key={item.id}
                type="button"
                className={item.id === activeId ? 'tester-nav__item tester-nav__item--active' : 'tester-nav__item'}
                onClick={() => setActiveId(item.id)}
              >
                <span>{item.label}</span>
                <small>{item.group}</small>
              </button>
            ))}
          </Surface>

          <div className="tester-main">
            {renderPanel()}
            <Surface className="tester-diagnostics" material="glass-thin" tone="card" data-testid={testerTestIds.runtimeDiagnostics}>
              <div>
                <p className="eyebrow">Runtime Diagnostics</p>
                <h2>SDK and session projection</h2>
              </div>
              <div className="tester-detail-list">
                <span>Scheduling owner: {summary?.schedulingOwner || 'runtime'}</span>
                <span>Provider catalog: {summary?.providerCatalogSurface || 'runtimeAdmin.listProviderCatalog'}</span>
                <span>App-local defaults: {summary?.appLocalProviderDefaults === false ? 'forbidden' : 'checking'}</span>
              </div>
              {summary?.runtime ? <pre className="tester-json">{JSON.stringify(summary.runtime, null, 2)}</pre> : null}
            </Surface>
            {historyError ? (
              <InlineAlert tone="warning">
                <div className="runtime-alert-copy">
                  <strong>History persistence unavailable</strong>
                  <span>{historyError}</span>
                </div>
              </InlineAlert>
            ) : null}
          </div>
        </div>
      ) : null}
    </section>
  );
}
