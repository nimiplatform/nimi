    "check:apps-avatar-isolation": "node scripts/check-apps-avatar-isolation.mjs",
    "check:eol-noise": "node scripts/check-eol-noise.mjs",
    "check:eol-noise:staged": "node scripts/check-eol-noise.mjs --staged-only --quiet-success",
    "check:text-encoding": "node scripts/check-text-encoding-gate.mjs",
    "check:text-encoding:staged": "node scripts/check-text-encoding-gate.mjs --staged-only --quiet-success",
