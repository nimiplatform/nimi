    "check:runtime-provider-endpoint-ssot": "node scripts/check-runtime-provider-endpoint-ssot.mjs",
    "check:runtime-connector-auth-profile-drift": "node scripts/generate-runtime-connector-auth-profiles.mjs --check",
    "check:managed-image-backend-package-drift": "node --test scripts/generate-managed-image-backend-packages.test.mjs && node scripts/generate-managed-image-backend-packages.mjs --check",
    "check:sdk-connector-auth-acquisition-profile-drift": "node scripts/generate-sdk-connector-auth-acquisition-profiles.mjs --check",
    "check:desktop-design-contract": "node scripts/check-desktop-design-contract.mjs",
    "check:nimi-kit": "pnpm --filter @nimiplatform/kit build && pnpm check:nimi-kit:prepared",
    "check:nimi-kit:prepared": "node scripts/check-nimi-kit.mjs && pnpm check:runtime-bridge-generated-drift && pnpm check:nimi-design-artifacts && pnpm check:kit-feature-adapter-boundary && pnpm check:kit-ui-consistency && node scripts/check-kit-package-dist.mjs && node scripts/check-canonical-capability-catalog.mjs",
