{
  "name": "@nimiplatform/nimi",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-go-env.mjs",
    "build": "node scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "build:prepared": "pnpm build:install-gateway && pnpm --filter @nimiplatform/desktop build && pnpm --filter @nimiplatform/web build && pnpm --filter @nimiplatform/lab build",
