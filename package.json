    "gen:canonical-capability-catalog": "node scripts/gen-canonical-capability-catalog.mjs",
    "check:nimi-design-artifacts": "node scripts/generate-nimi-design-md.mjs --check",
    "check:nimi-ui-lib-drift": "node scripts/check-nimi-ui-lib-drift.mjs",
    "check:nimi-ui-pattern": "node scripts/check-nimi-ui-pattern.mjs",
