    "test:kit:native": "cargo test --locked --manifest-path kit/shell/protected-local/Cargo.toml && cargo test --locked --manifest-path kit/shell/protected-local-node/Cargo.toml && cargo build --locked --manifest-path kit/shell/protected-local-node/Cargo.toml && node kit/shell/protected-local-node/test/native-input-contract.cjs && cargo test --locked --manifest-path kit/shell/tauri/Cargo.toml",
