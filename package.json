    "check:ui-glass-boundary": "node scripts/check-ui-glass-boundary.mjs",
    "check:no-ai-profile-provider-model-constants": "node scripts/check-no-ai-profile-provider-model-constants.mjs",
    "check:no-desktop-as-user-facing-name": "node scripts/check-no-desktop-as-user-facing-name.mjs",
    "check:home-shell-no-runtime-internal-import": "node scripts/check-home-shell-no-runtime-internal-import.mjs",
    "check:home-shell-aiscoperef-required": "node scripts/check-home-shell-aiscoperef-required.mjs",
