    "check:sdk-version-matrix": "node scripts/check-sdk-version-matrix.mjs",
    "check:sdks-generators": "node --test sdks/generators/lib/typed-clients-rust.test.mjs && node sdks/generators/generate.mjs --check",
    "check:sdks-conformance-typed-core": "node sdks/conformance/run.mjs --language all --profile typed-core",
    "check:sdk-vnext-runtime-consumer-smoke": "node scripts/check-sdk-vnext-runtime-consumer-smoke.mjs",
    "check:sdk-vnext-public-surface-smoke": "node scripts/check-sdk-vnext-public-surface-smoke.mjs",
    "check:sdk-vnext-app-consumer-smoke": "node scripts/check-sdk-vnext-app-consumer-smoke.mjs",
    "check:sdk-vnext-realm-consumer-smoke": "node scripts/check-sdk-vnext-realm-consumer-smoke.mjs",
    "check:sdk-vnext-ai-consumer-smoke": "node scripts/check-sdk-vnext-ai-consumer-smoke.mjs",
    "check:sdk-vnext-ai-runner-consumer-smoke": "node scripts/check-sdk-vnext-ai-runner-consumer-smoke.mjs",
    "check:sdk-vnext-root-consumer-smoke": "node scripts/check-sdk-vnext-root-consumer-smoke.mjs",
    "check:sdk-kit-pack-audit": "node scripts/check-sdk-kit-pack-audit.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:experimental-api-lifecycle": "node scripts/check-experimental-api-lifecycle.mjs",
    "check:markdown": "pnpm dlx markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "check:install-script-smoke": "node scripts/check-install-script-smoke.mjs",
    "check:npm-binary-smoke": "pnpm build:runtime && node scripts/check-npm-binary-smoke.mjs",
    "check:no-absolute-user-paths": "node scripts/check-no-absolute-user-paths.mjs",
    "check:shared-runtime-defaults-duplicate": "node scripts/check-shared-runtime-defaults-duplicate.mjs",
    "check:go-env": "node scripts/check-go-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "update:secrets-baseline": "node scripts/check-secrets.mjs --update",
    "live:audio-fixtures": "node scripts/live-audio-fixtures.mjs",
    "run:seedance-video-smoke": "node scripts/run-seedance-video-smoke.mjs",
    "proto:generate": "node scripts/run-buf.mjs generate",
    "proto:lint": "node scripts/run-buf.mjs lint",
    "proto:breaking": "node scripts/proto-breaking.mjs",
    "proto:drift-check": "node scripts/check-proto-drift.mjs",
    "check:actionlint": "node scripts/check-actionlint.mjs",
    "deploy:install-gateway": "pnpm --filter @nimiplatform/install-gateway deploy",
    "dev:prepare": "pnpm build:sdk && pnpm build:kit",
    "dev:prepare:watch": "node scripts/dev-prepare-watch.mjs",
    "doctor:dev": "node scripts/doctor-dev.mjs",
    "dev:desktop": "node scripts/dev-app.mjs desktop",
    "dev:zhiyu": "node scripts/dev-app.mjs zhiyu",
    "dev:lab": "node scripts/dev-app.mjs lab",
    "dev:avatar": "node scripts/dev-app.mjs avatar",
    "dev:macos:desktop:installed": "pnpm --filter @nimiplatform/desktop dev:macos:installed",
    "dev:electron:desktop": "node scripts/dev-app.mjs desktop --electron",
    "dev:electron:zhiyu": "node scripts/dev-app.mjs zhiyu --electron",
    "dev:electron:lab": "node scripts/dev-app.mjs lab --electron",
    "dev:electron:avatar": "node scripts/dev-app.mjs avatar --electron",
    "dev:web": "pnpm --filter @nimiplatform/web dev",
    "docs:dev": "pnpm --filter @nimiplatform/docs dev",
    "docs:build": "pnpm --filter @nimiplatform/docs build",
    "docs:preview": "pnpm --filter @nimiplatform/docs preview",
    "lint": "pnpm check:no-app-realm-rest-bypass && pnpm check:actionlint",
    "test:workspace:prepared": "pnpm --recursive --filter=!@nimiplatform/nimi --if-present test",
    "test:extended:prepared": "pnpm --filter @nimiplatform/app-tools run test:full && pnpm --filter @nimiplatform/simulator run test:full:prepared",
    "test:full:prepared": "pnpm run test:workspace:prepared && pnpm run test:extended:prepared && node scripts/run-script-tests.mjs",
    "test:workspace:full": "node scripts/with-workspace-surfaces.mjs -- pnpm run test:full:prepared",
    "test": "node scripts/with-workspace-surfaces.mjs -- pnpm run test:workspace:prepared",
    "test:full": "pnpm test:workspace:full && pnpm test:runtime:go && pnpm test:runtime:python",
    "spec:authority:consumers": "pnpm exec nimicoding authority consumers . --spec .nimi/spec --max-files 20000 --max-refs 50000 --max-bytes 268435456",
    "spec:authority:terms": "pnpm exec nimicoding authority terms . --spec .nimi/spec --max-units 5000 --max-terms 20000 --max-bytes 33554432",
    "spec:authority:closed-sets": "pnpm exec nimicoding authority closed-sets . --spec .nimi/spec --max-units 5000 --max-sets 5000 --max-bytes 268435456",
    "spec:authority:check": "pnpm exec nimicoding authority check .nimi/spec --scope-bindings .nimi/config/authority-scope-bindings.yaml",
    "spec:authority:compile": "pnpm exec nimicoding authority compile .nimi/spec",
    "spec:authority:audit": "pnpm exec nimicoding authority audit .nimi/spec --bindings .nimi/config/authority-verifiers.yaml --max-units 5000 --max-edges 50000 --max-bytes 33554432",
    "nimicoding:sync": "pnpm exec nimicoding sync --check",
    "check:nimi-coding-seed-sync": "pnpm nimicoding:sync",
    "nimicoding:doctor": "pnpm exec nimicoding doctor",
    "kit:preview": "pnpm --filter @nimiplatform/kit preview"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nimiplatform/nimi-coding": "0.6.1",
    "@protobuf-ts/plugin": "2.11.1"
  }
}
