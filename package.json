    "test:lab:native": "cargo test --locked --manifest-path apps/lab/src-tauri/Cargo.toml",
    "test:scripts": "node scripts/with-workspace-surfaces.mjs -- node scripts/run-script-tests.mjs",
    "dev:runtime": "node scripts/dev-runtime.mjs",
    "accept:runtime:fixed-service": "node scripts/accept-runtime-fixed-service.mjs",
