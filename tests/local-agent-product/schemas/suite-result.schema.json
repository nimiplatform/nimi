{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nimi.local-agent-product-suite-result/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteTrialId", "suiteId", "layers", "sourceState", "durationMs", "checkpoints", "leafResults", "artifacts", "processProblems", "privacy", "outcome", "executionPolicy"],
  "properties": {
    "schemaVersion": {"const": "nimi.local-agent-product-suite-result/v2"},
    "suiteTrialId": {"type": "string", "minLength": 1},
    "suiteId": {"enum": ["contract-smoke", "deterministic-exhaustive"]},
    "layers": {"type": "array", "items": {"enum": ["L0", "L1", "L4"]}},
    "sourceState": {"type": "object"},
    "durationMs": {"type": "integer", "minimum": 0},
    "checkpoints": {"type": "array", "minItems": 1},
    "leafResults": {"type": "array", "minItems": 1},
    "artifacts": {"type": "array", "minItems": 1},
    "processProblems": {"type": "array"},
    "privacy": {"type": "object", "required": ["ok", "findings"]},
    "outcome": {"enum": ["passed", "failed"]},
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "logicalLeafTrialCount", "groupedProcessCount", "fullEnvironmentPerLeaf"],
      "properties": {
        "mode": {"enum": ["contract", "exhaustive"]},
        "logicalLeafTrialCount": {"type": "integer", "minimum": 1},
        "groupedProcessCount": {"type": "integer", "minimum": 1},
        "fullEnvironmentPerLeaf": {"const": false}
      }
    }
  }
}
