{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nimi.local-agent-product-journey-result/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeyTrialId", "journeyId", "tier", "batch", "repeatIndex", "sourceState", "environmentIdentity", "durationMs", "checkpoints", "leafResults", "artifacts", "processProblems", "privacy", "outcome"],
  "properties": {
    "schemaVersion": {"const": "nimi.local-agent-product-journey-result/v2"},
    "journeyTrialId": {"type": "string", "minLength": 1},
    "journeyId": {"type": "string", "minLength": 1},
    "tier": {"enum": ["L2", "L3"]},
    "batch": {"type": "string", "minLength": 1},
    "repeatIndex": {"type": "integer", "minimum": 1},
    "sourceState": {"type": "object"},
    "environmentIdentity": {
      "type": "object",
      "required": ["rootId", "processStarts"],
      "properties": {
        "rootId": {"type": "string", "minLength": 1},
        "accountIds": {"$ref": "#/$defs/identityArray"},
        "worldIds": {"$ref": "#/$defs/identityArray"},
        "sourceIds": {"$ref": "#/$defs/identityArray"},
        "runtimeSourceRefs": {"$ref": "#/$defs/identityArray"},
        "localAgentIds": {"$ref": "#/$defs/identityArray"},
        "processStarts": {"type": "object"}
      }
    },
    "durationMs": {"type": "integer", "minimum": 0},
    "checkpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkpoint"}},
    "leafResults": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leafResult"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "processProblems": {"type": "array"},
    "privacy": {"type": "object", "required": ["ok", "findings"]},
    "outcome": {"enum": ["passed", "failed", "blocked_by_failed_prerequisite"]}
  },
  "$defs": {
    "identityArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "prerequisiteIds", "startedAt", "completedAt", "correlations", "assertions", "artifactRefs", "outcome"],
      "properties": {
        "checkpointId": {"type": "string", "minLength": 1},
        "prerequisiteIds": {"type": "array", "items": {"type": "string"}},
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "correlations": {"type": "object"},
        "assertions": {"type": "array", "items": {"type": "object", "required": ["assertionId", "outcome"]}},
        "artifactRefs": {"type": "array", "items": {"type": "string"}},
        "outcome": {"enum": ["passed", "failed", "blocked_by_failed_prerequisite"]}
      }
    },
    "leafResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leafId", "journeyTrialId", "checkpointIds", "assertionIds", "evidenceRefs", "outcome", "failureClass"],
      "properties": {
        "leafId": {"type": "string", "minLength": 1},
        "journeyTrialId": {"type": "string", "minLength": 1},
        "checkpointIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assertionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcome": {"enum": ["passed", "failed", "blocked_by_failed_prerequisite"]},
        "failureClass": {"type": ["string", "null"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "sha256", "bytes", "privacyClass"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "privacyClass": {"const": "safe_evidence"}
      }
    }
  }
}
