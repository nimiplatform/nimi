{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nimi.local-agent-product-artifact-manifest/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultIdentity", "privacy", "files"],
  "properties": {
    "schemaVersion": {"const": "nimi.local-agent-product-artifact-manifest/v2"},
    "resultIdentity": {"type": "string", "minLength": 1},
    "privacy": {"type": "object", "required": ["ok", "findings"]},
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "privacyClass"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "privacyClass": {"const": "safe_evidence"}
        }
      }
    }
  }
}
