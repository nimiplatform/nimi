{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nimi.local-agent-conversation-run-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "scenarioId", "processStarts", "materializations", "noRetry", "modelCount", "repeatCount", "files"],
  "properties": {
    "schemaVersion": {"const": "nimi.local-agent-conversation-run-manifest/v1"},
    "runId": {"type": "string", "minLength": 1},
    "scenarioId": {"const": "conversation-report-baseline"},
    "processStarts": {"type": "object"},
    "materializations": {"type": "object"},
    "noRetry": {"const": true},
    "modelCount": {"const": 1},
    "repeatCount": {"const": 1},
    "files": {"type": "array", "minItems": 1}
  }
}
