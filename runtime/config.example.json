{
  "schemaVersion": 1,
  "grpcAddr": "127.0.0.1:46371",
  "httpAddr": "127.0.0.1:46372",
  "shutdownTimeoutSeconds": 10,
  "localStatePath": "~/.nimi/runtime/local-state.json",
  "dataRootRef": "/absolute/path/to/nimi_data",
  "managedRoots": {
    "models": "/absolute/path/to/nimi_data/models",
    "dependencies": "/absolute/path/to/nimi_data/dependencies",
    "environments": "/absolute/path/to/nimi_data/environments",
    "logs": "/absolute/path/to/nimi_data/logs",
    "audit": "/absolute/path/to/nimi_data/audit"
  },
  "aiHealthIntervalSeconds": 8,
  "aiHttpTimeoutSeconds": 30,
  "globalConcurrencyLimit": 8,
  "perAppConcurrencyLimit": 2,
  "idempotencyCapacity": 10000,
  "maxDelegationDepth": 3,
  "auditRingBufferSize": 20000,
  "usageStatsBufferSize": 50000,
  "localAuditCapacity": 5000,
  "sessionTtlMinSeconds": 60,
  "sessionTtlMaxSeconds": 86400,
  "providers": {}
}
