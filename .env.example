# Nimi monorepo local development env template.
# Copy to `.env` (or export in shell) and adjust values per workspace.

# Source Nimi defaults to official Realm. Use --realm local or this selection
# only when deliberately working with your own local Realm.
NIMI_DEV_REALM=official
NIMI_DEV_REALM_URL=http://127.0.0.1:3002
NIMI_DEV_REALTIME_URL=http://127.0.0.1:3003
NIMI_DEV_WEB_URL=http://localhost:3000
NIMI_DEV_REALM_ENVIRONMENT_ID=dev

# Optional explicit local Realm workspace. Used only in local mode when
# starting/checking Realm dependencies; must provide dev:infra, dev:api and
# dev:realtime scripts. Relative paths resolve from this repository root.
# Leave empty when you manage the already-running Realm services separately.
NIMI_DEV_REALM_DIR=

NIMI_RUNTIME_BRIDGE_MODE=RUNTIME

# Official Web development target. Source Home/Runtime resolves its own selected
# profile and never takes an account token from this file.
NIMI_REALM_URL=https://realm.nimi.ai
NIMI_WEB_URL=https://nimi.ai
NIMI_REALTIME_URL=https://realm.nimi.ai
