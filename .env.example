# Nimi monorepo local development env template.
# Copy to `.env.local` (or export in shell) and adjust values per workspace.

NIMI_RUNTIME_BRIDGE_MODE=RUNTIME
# Runtime first-party Nimi App admission registry used by local dev Runtime.
# `pnpm dev:runtime` defaults this to the repo Platform registry when omitted.
NIMI_RUNTIME_APP_REGISTRY_PATH=/ABS/PATH/TO/nimi/.nimi/spec/platform/kernel/tables/nimi-app-registry.yaml

# Runtime/Realm connectivity (optional defaults shown).
# - Desktop runtime/data-sync directly uses NIMI_REALM_URL.
# - Web dev keeps same-origin requests and uses Vite proxy -> NIMI_REALM_URL.
NIMI_REALM_URL=http://localhost:3002
# Runtime control-plane base URL (policy/signature/grant/audit).
NIMI_CONTROL_PLANE_URL=http://localhost
# Web application base URL for links and browser surfaces that intentionally open the Web app.
# Desktop account login is Runtime-owned OAuth with the localhost:46373 callback; it does not use this value as an auth relay.
NIMI_WEB_URL=http://localhost
NIMI_REALTIME_URL=
NIMI_ACCESS_TOKEN=
