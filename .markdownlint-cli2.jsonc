{
  "config": {
    "default": false,
    "MD009": true,
    "MD010": { "code_blocks": false },
    "MD012": true
  },
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!**/.git/**",
    "!**/.cache/**",
    "!_external/**",
    "!archive/**",
    "!.local/**",
    "!.nimi/local/**",
    "!.nimi/topics/**",
    "!**/dist/**",
    "!**/target/**",
    "!**/coverage/**",
    "!tmp/**"
  ]
}
