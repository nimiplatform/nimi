{
  "name": "@nimiplatform/avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1427 --strictPort",
    "dev:electron": "node scripts/run-electron-dev.mjs",
    "build:renderer": "vite build",
    "build:electron:prepared": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:electron": "pnpm run build:electron:prepared",
    "check:bundle-runtime-imports": "node scripts/check-avatar-bundle-runtime-imports.mjs",
    "smoke:agent-center-live2d": "node scripts/smoke-agent-center-live2d.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0",
    "check:apps-avatar-isolation": "node ../../scripts/check-apps-avatar-isolation.mjs",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@pixiv/three-vrm-core": "^3.5.5",
    "@react-three/fiber": "^9.7.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "scheduler": "0.27.0",
    "three": "^0.185.1",
    "wlipsync": "^1.3.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  }
}
