{
  "name": "@nimiplatform/avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1 --port 1427 --strictPort",
    "dev:electron": "corepack pnpm run build:electron && electron dist-electron/main.js",
    "dev:shell": "tauri dev --config src-tauri/tauri.conf.json",
    "build:renderer": "vite build",
    "build:electron": "corepack pnpm --filter @nimiplatform/kit build && tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "check:bundle-runtime-imports": "node scripts/check-avatar-bundle-runtime-imports.mjs",
    "check:acceptance-recording-matrix": "node scripts/record-avatar-acceptance-matrix.mjs --check-only",
    "smoke:agent-center-live2d": "node scripts/smoke-agent-center-live2d.mjs",
    "smoke:vrm-wave5": "node scripts/run-vrm-wave5-smoke.mjs",
    "record:acceptance-matrix": "node scripts/record-avatar-acceptance-matrix.mjs",
    "record:acceptance-matrix:automated": "node scripts/record-avatar-acceptance-matrix.mjs --automated-only --allow-manual-pending",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run build:renderer && (cd src-tauri && cargo check)",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0 && (cd src-tauri && cargo check)",
    "check:spec-consistency": "npx tsx scripts/check-avatar-spec-consistency.ts",
    "check:apps-avatar-isolation": "node ../../scripts/check-apps-avatar-isolation.mjs",
    "test": "vitest run",
    "test:e2e:electron": "corepack pnpm run build:renderer && corepack pnpm run build:electron && node --test test/electron-acceptance.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/nimi2d": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@pixiv/three-vrm-core": "^3.5.5",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "pixi.js": "^8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^16.5.8",
    "scheduler": "0.27.0",
    "three": "^0.185.1",
    "wlipsync": "^1.3.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  }
}
