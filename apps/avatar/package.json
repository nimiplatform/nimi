{
  "name": "@nimiplatform/avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1 --port 1427 --strictPort",
    "dev:electron": "node scripts/run-electron-dev.mjs",
    "dev:shell": "tauri dev --config src-tauri/tauri.conf.json",
    "build:renderer": "vite build",
    "build:electron:prepared": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:electron": "pnpm run build:electron:prepared",
    "check:bundle-runtime-imports": "node scripts/check-avatar-bundle-runtime-imports.mjs",
    "smoke:agent-center-live2d": "node scripts/smoke-agent-center-live2d.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run build:renderer && (cd src-tauri && cargo check --locked)",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0 && (cd src-tauri && cargo check --locked)",
    "check:apps-avatar-isolation": "node ../../scripts/check-apps-avatar-isolation.mjs",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/nimi2d": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@pixiv/three-vrm-core": "^3.5.5",
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "pixi.js": "^8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^16.5.8",
    "scheduler": "0.27.0",
    "three": "^0.185.1",
    "wlipsync": "^1.3.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  }
}
