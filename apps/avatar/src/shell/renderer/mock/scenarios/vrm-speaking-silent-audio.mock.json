{
  "scenario_id": "vrm-speaking-silent-audio",
  "version": "1",
  "description": "Drives the AudioPipelineController voice playback path with the SYNTHETIC mime application/x-nimi-synthetic-lipsync. Per the backend-branch contract's synthetic-mime fail-close rule, the controller fast-paths: NO AudioContext.decodeAudioData, NO sink.attachAudioSource, sink.silent() is invoked, state progresses idle → requested → completed (consumer state machine still advances). The mouth stays at zero; explicit silent voice + silent mouth (not pretending to animate).",
  "duration_ms": 2000,
  "loop": false,

  "agent_bootstrap": {
    "active_world_id": "world-mock-vrm-silent-audio",
    "active_user_id": "user-mock-vrm-silent-audio",
    "locale": "zh-CN",
    "initial_posture": {
      "posture_class": "baseline_observer",
      "action_family": "engage",
      "interrupt_mode": "welcome",
      "transition_reason": "scenario_start",
      "truth_basis_ids": []
    },
    "initial_status_text": "vrm speaking silent (synthetic) fixture",
    "initial_execution_state": "CHAT_ACTIVE"
  },

  "events": [
    { "kind": "time", "at_ms": 0, "type": "avatar.conversation.voice.audio_chunk", "detail": { "voice_id": "mock-voice-silent-001", "chunk_sequence": 1, "chunk_bytes": [1], "audio_mime_type": "application/x-nimi-synthetic-lipsync", "source": "mock" } }
  ],

  "vrm_mock_scenario": {
    "category": "vrm_speaking",
    "model_manifest": {
      "kind": "vrm",
      "modelId": "vrm-mock-silent-audio",
      "runtimeDir": ".cache/assets/vrm-models",
      "vrm": {
        "vrmFile": ".cache/assets/vrm-models/AvatarSample_Mock.vrm",
        "motionPresetsDir": null
      },
      "nimiDir": null,
      "posterPath": null
    },
    "audio": {
      "artifact_id": "synthetic://lipsync/turn-mock-001",
      "mime_type": "application/x-nimi-synthetic-lipsync",
      "synthetic": true
    },
    "expected": [
      { "kind": "audio_pipeline_state_sequence", "where": "AudioPipelineController", "details": { "states": ["idle", "requested", "completed"], "completed_reason": "synthetic_audio_no_playback" } },
      { "kind": "decode_not_called", "where": "AudioContext.decodeAudioData", "details": { "callCount": 0 } },
      { "kind": "sink_silent_invoked", "where": "BackendAudioConsumer.silent", "details": { "callCount_gte": 1 } },
      { "kind": "sink_attach_not_invoked", "where": "BackendAudioConsumer.attachAudioSource", "details": { "callCount": 0 } },
      { "kind": "lipsync_remains_silent", "where": "vrmLipsyncDriver.tick", "details": { "active": false } }
    ],
    "human_acceptance_checks": [
      "synthetic 路径下嘴型不动",
      "audio playback 状态机仍前进到 completed（消费者状态机不卡死）",
      "AudioContext.decodeAudioData 未被调用（fast-path）",
      "sink.silent 被调用至少一次"
    ]
  }
}
