{
  "name": "@nimiplatform/lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1468 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "init": "nimi-app init",
    "typecheck:prepared": "tsc --noEmit",
    "typecheck": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run typecheck:prepared",
    "build:prepared": "tsc --noEmit && vite build",
    "build": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "build:electron": "node ../../scripts/build-supervised-app-electron.mjs --consumer lab",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- node --test test/*.test.mjs",
    "check": "pnpm run test && pnpm run validate",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@sparkjsdev/spark": "2.1.0",
    "fflate": "0.8.3",
    "i18next": "26.3.6",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@nimiplatform/nimi-coding": "0.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "yaml": "^2.9.0"
  }
}
