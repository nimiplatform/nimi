{
  "period": {
    "periodId": {
      "type": "string",
      "required": true,
      "pattern": "^PO-SP-[A-Z]{3,6}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "ageRange": {
      "type": "object",
      "required": true,
      "fields": {
        "startMonths": {
          "type": "integer"
        },
        "peakMonths": {
          "type": "integer",
          "description": "敏感期高峰月龄"
        },
        "endMonths": {
          "type": "integer"
        }
      }
    },
    "observableSigns": {
      "type": "array",
      "items": "string",
      "required": true,
      "description": "家长可观察到的行为信号"
    },
    "supportStrategies": {
      "type": "array",
      "items": "string",
      "required": true,
      "description": "家长支持策略"
    },
    "commonMistakes": {
      "type": "array",
      "items": "string",
      "required": true,
      "description": "常见误区"
    },
    "source": {
      "type": "string",
      "required": true
    }
  }
}
