{
  "ability": {
    "abilityId": {
      "type": "string",
      "required": true,
      "pattern": "^PO-ABL-[A-Z]{3,6}-[0-9]{3}$"
    },
    "layer": {
      "type": "enum",
      "required": true,
      "values": [
        "bedrock",
        "foundation",
        "quality-control",
        "creative-engine",
        "drive",
        "network"
      ]
    },
    "displayName": {
      "type": "string",
      "required": true
    },
    "parentQuestion": {
      "type": "string",
      "required": true,
      "description": "面向家长的一句话概括"
    },
    "description": {
      "type": "string",
      "required": true
    },
    "sourceObservations": {
      "type": "array",
      "items": "string",
      "required": true,
      "description": "映射的底层观察维度 dimensionId 列表（来自 observation-framework data asset）"
    },
    "ageRelevance": {
      "type": "object",
      "required": true,
      "fields": {
        "startMonths": {
          "type": "integer"
        },
        "endMonths": {
          "type": "integer",
          "description": "-1 表示无上限"
        }
      }
    },
    "developmentalAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": {
          "ageRange": {
            "type": "string",
            "description": "年龄段描述"
          },
          "whatToLookFor": {
            "type": "string",
            "description": "在这个年龄段，该能力的表现形式"
          }
        }
      },
      "required": true,
      "description": "不同年龄段的行为锚点——让 AI 知道该能力在各阶段长什么样"
    },
    "aiAnalysisPrompt": {
      "type": "string",
      "required": true,
      "description": "AI 生成报告时使用的分析视角提示"
    }
  }
}
