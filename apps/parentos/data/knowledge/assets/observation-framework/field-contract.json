{
  "dimension": {
    "dimensionId": {
      "type": "string",
      "required": true,
      "pattern": "^PO-OBS-[A-Z]{3,6}-[0-9]{3}$"
    },
    "displayName": {
      "type": "string",
      "required": true
    },
    "parentQuestion": {
      "type": "string",
      "required": true,
      "description": "用家长能理解的一句话概括这个维度"
    },
    "ageRelevance": {
      "type": "object",
      "fields": {
        "startMonths": {
          "type": "integer"
        },
        "endMonths": {
          "type": "integer",
          "description": "-1 表示无上限"
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": {
          "signal": {
            "type": "string",
            "description": "可观察的行为信号"
          },
          "meaning": {
            "type": "string",
            "description": "这个信号可能意味着什么"
          }
        }
      }
    },
    "guidedQuestions": {
      "type": "array",
      "items": "string",
      "description": "引导家长观察的具体问题"
    },
    "quickTags": {
      "type": "array",
      "items": "string",
      "description": "快速记录时的预设标签"
    },
    "source": {
      "type": "string",
      "required": true
    }
  }
}
