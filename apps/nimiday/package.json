{
  "name": "@nimiplatform/nimiday",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1523 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "typecheck:prepared": "tsc --noEmit",
    "typecheck": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run typecheck:prepared",
    "build:prepared": "tsc --noEmit && vite build",
    "build": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "build:electron": "node ../../scripts/build-supervised-app-electron.mjs --consumer nimiday",
    "build:electron:production": "node ../../scripts/build-supervised-app-electron-production.mjs --consumer nimiday",
    "test:app": "vitest run",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run test:app",
    "validate": "node scripts/validate.mjs",
    "typecheck:test:prepared": "tsc -p tsconfig.test.json",
    "typecheck:test": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run typecheck:test:prepared",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "tsx": "4.23.15"
  },
  "author": "Nimi",
  "license": "MIT"
}
