{
  "name": "@nimiplatform/zhiyu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 1472 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "typecheck:prepared": "tsc --noEmit",
    "typecheck": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run typecheck:prepared",
    "build:prepared": "tsc --noEmit && vite build",
    "build": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "build:electron": "node ../../scripts/build-supervised-app-electron.mjs --consumer zhiyu",
    "test:unit:prepared": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run test:unit:prepared"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "fflate": "0.8.3",
    "lucide-react": "1.28.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
