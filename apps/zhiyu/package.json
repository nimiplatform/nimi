{
  "name": "@nimiplatform/zhiyu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 1472 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:electron": "node ../../scripts/build-supervised-app-electron.mjs --consumer zhiyu",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "dev:web": "nimi-app dev --platform web",
    "dev:web-renderer": "vite --mode web",
    "build:web": "tsc --noEmit && vite build --mode web"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
