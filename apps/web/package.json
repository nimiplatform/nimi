{
  "name": "@nimiplatform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-landing-data.mjs",
    "prebuild": "node scripts/generate-landing-data.mjs",
    "build:prepared": "pnpm run typecheck && vite build",
    "build": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "preview": "vite preview",
    "generate-landing-data": "node scripts/generate-landing-data.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- tsx --tsconfig tsconfig.test.json --test test/**/*.test.ts"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
