{
  "name": "@nimiplatform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "predev": "node scripts/generate-landing-data.mjs",
    "prebuild": "node scripts/generate-landing-data.mjs",
    "build:prepared": "pnpm run typecheck && vite build",
    "build": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:prepared",
    "preview": "vite preview",
    "generate-landing-data": "node scripts/generate-landing-data.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test:dev": "node --test scripts/dev-server.test.mjs",
    "test:hosting": "node --test scripts/cloudflare-hosting.test.mjs",
    "test": "pnpm run test:dev && pnpm run test:hosting && node ../../scripts/with-workspace-surfaces.mjs -- tsx --tsconfig tsconfig.test.json --test test/**/*.test.ts"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "i18next": "26.7.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-router-dom": "7.18.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  }
}
