{
  "compilerOptions": {
    "paths": {
      "@desktop-public/*": ["../desktop/src/public-web/*"],
      "@renderer/features/chat/chat-agent-avatar-live2d-cubism-runtime-loader": ["./src/desktop-adapter/chat-agent-avatar-live2d-cubism-runtime-loader.web.ts"],
      "@renderer/infra/bootstrap/runtime-bootstrap": ["./src/desktop-adapter/runtime-bootstrap.web.ts"],
      "@renderer/features/runtime-config/runtime-config-panel-view": ["./src/desktop-adapter/runtime-config-panel.web.tsx"],
      "@renderer/bridge": ["./src/desktop-adapter/bridge.web.ts"],
      "@runtime/*": ["../desktop/src/runtime/*"],
      "@renderer/*": ["../desktop/src/shell/renderer/*"],
      "@nimiplatform/sdk/runtime": ["../../sdk/src/runtime/browser.ts"],
      "@nimiplatform/sdk": ["../../sdk/src/index.ts"],
      "@nimiplatform/sdk/*": ["../../sdk/src/*"],
      "@nimiplatform/kit/ui": ["../../kit/ui/src/index.ts"],
      "@nimiplatform/kit/ui/*": ["../../kit/ui/src/*"],
      "@nimiplatform/kit/auth": ["../../kit/auth/src/index.ts"],
      "@nimiplatform/kit/auth/*": ["../../kit/auth/src/*"],
      "@nimiplatform/kit/core/*": ["../../kit/core/src/*"],
      "@nimiplatform/kit/features/avatar": ["../../kit/features/avatar/src/index.ts"],
      "@nimiplatform/kit/features/avatar/*": ["../../kit/features/avatar/src/*"],
      "@nimiplatform/kit/features/chat": ["../../kit/features/chat/src/index.ts"],
      "@nimiplatform/kit/features/chat/*": ["../../kit/features/chat/src/*"],
      "@nimiplatform/kit/features/commerce": ["../../kit/features/commerce/src/index.ts"],
      "@nimiplatform/kit/features/commerce/*": ["../../kit/features/commerce/src/*"],
      "@nimiplatform/kit/features/generation": ["../../kit/features/generation/src/index.ts"],
      "@nimiplatform/kit/features/generation/*": ["../../kit/features/generation/src/*"],
      "@nimiplatform/kit/features/model-config": ["../../kit/features/model-config/src/index.ts"],
      "@nimiplatform/kit/features/model-config/*": ["../../kit/features/model-config/src/*"],
      "@nimiplatform/kit/features/model-picker": ["../../kit/features/model-picker/src/index.ts"],
      "@nimiplatform/kit/features/model-picker/*": ["../../kit/features/model-picker/src/*"],
      "@nimiplatform/kit/shell/renderer/bridge": ["../../kit/shell/renderer/src/bridge/index.ts"],
      "@nimiplatform/kit/shell/renderer/bridge/*": ["../../kit/shell/renderer/src/bridge/*"],
      "@nimiplatform/kit/telemetry": ["../../kit/telemetry/src/telemetry/index.ts"],
      "@nimiplatform/kit/telemetry/*": ["../../kit/telemetry/src/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../desktop/src/**/*.d.ts",
    "../desktop/src/**/*.ts",
    "../desktop/src/**/*.tsx",
    "../../sdk/src/**/*.ts",
    "../../sdk/src/**/*.tsx",
    "../../kit/auth/src/**/*.d.ts",
    "../../kit/auth/src/**/*.ts",
    "../../kit/auth/src/**/*.tsx",
    "../../kit/core/src/**/*.ts",
    "../../kit/features/**/src/**/*.ts",
    "../../kit/features/**/src/**/*.tsx",
    "../../kit/shell/renderer/src/**/*.ts",
    "../../kit/shell/renderer/src/**/*.tsx",
    "../../kit/telemetry/src/**/*.d.ts",
    "../../kit/telemetry/src/**/*.ts",
    "../../kit/telemetry/src/**/*.tsx",
    "../../kit/ui/src/**/*.d.ts",
    "../../kit/ui/src/**/*.ts",
    "../../kit/ui/src/**/*.tsx"
  ]
}
