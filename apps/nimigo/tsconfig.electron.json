{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src-electron/**/*.ts",
    "src-electron/**/*.cts",
    "src/product/**/*.ts",
    "src/product/vite-env.d.ts"
  ]
}
