{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "src-electron",
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src-electron/**/*.ts",
    "src-electron/**/*.cts"
  ]
}
