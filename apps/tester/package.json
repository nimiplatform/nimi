{
  "name": "@nimiplatform/tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1468 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "dev:tauri": "nimi-app dev --shell tauri",
    "dev:shell": "nimi-app dev",
    "init": "nimi-app init",
    "prepare:workspace-surfaces": "corepack pnpm --filter @nimiplatform/sdk build && corepack pnpm --filter @nimiplatform/kit build",
    "typecheck": "pnpm run prepare:workspace-surfaces && tsc --noEmit",
    "build": "pnpm run prepare:workspace-surfaces && tsc --noEmit && vite build",
    "build:electron": "pnpm run prepare:workspace-surfaces && tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:shell": "tauri build",
    "test:e2e:electron": "corepack pnpm run build && corepack pnpm run build:electron && node --test test/electron-acceptance.mjs",
    "test:e2e:tauri": "corepack pnpm run test:e2e:tauri:plain-negative",
    "test:e2e:tauri:plain-negative": "corepack pnpm run build && node scripts/run-tauri-acceptance.mjs",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- node --test test/*.test.mjs",
    "check:shell-static-parity": "node scripts/check-shell-parity.mjs",
    "check:shell-parity": "pnpm run check:shell-static-parity && pnpm run test:e2e:electron && pnpm run test:e2e:tauri",
    "check": "pnpm run test && pnpm run validate",
    "pack": "pnpm run build && node scripts/pack.mjs",
    "validate": "node scripts/validate.mjs",
    "local-audit": "node scripts/local-audit.mjs",
    "doctor": "nimi-app doctor",
    "update": "nimi-app update"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@tauri-apps/api": "^2.9.1",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@nimiplatform/nimi-coding": "0.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.5.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
