{
  "name": "@nimiplatform/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build/check-modules.mjs && vite",
    "check:selected-sources": "node build/check-selected-sources.mjs",
    "check:modules": "node build/check-modules.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run check:modules && pnpm run typecheck && vite build && node build/write-artifact-manifest.mjs",
    "preview": "vite preview",
    "test": "node ../../scripts/with-workspace-surfaces.mjs -- node --test test/*.test.mjs",
    "test:contract": "pnpm --filter @nimiplatform/sdk build && pnpm --filter @nimiplatform/kit build && pnpm run test:contract:prepared",
    "test:contract:prepared": "node --test test/contract/*.test.mjs"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@tanstack/react-query": "5.100.11",
    "i18next": "25.8.18",
    "lucide-react": "0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "16.5.8",
    "react-router-dom": "7.15.1",
    "scheduler": "0.27.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "yaml": "2.9.0"
  }
}
