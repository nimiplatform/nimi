{
  "supportedLocales": [
    "en",
    "zh"
  ],
  "audit": {
    "scopeDirs": [
      "src/shell/renderer",
      "src/shell/renderer/index.html"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".html"
    ],
    "excludePathPatterns": [
      "/test/",
      ".test.",
      ".spec.",
      "settings-assets.tsx"
    ],
    "allowTextPatterns": [
      "^CRASH$",
      "^You$",
      "^Agent$",
      "^Human$",
      "^Error$",
      "^unknown$",
      "^-$",
      "^--$",
      "^[A-Z0-9_]+$",
      "^MetaMask$",
      "^Binance Wallet$",
      "^OKX Wallet$",
      "^Google$",
      "^Google login$",
      "^Nimi$",
      "^Nimi Desktop$",
      "^Nimi Runtime$",
      "^(zh-cn, en-us|t2v, i2v_first_frame|resolution, ratio, duration_sec)$",
      "^(local-agent:desktop:\\.\\.\\.|runtime-source:\\.\\.\\.|user-1|anchor-1)$",
      "^(sha256|ID):$",
      "^(mp3|wav|ogg|pcm|auto|base64|url)$",
      "^/absolute/path/to/nimi_data$"
    ]
  }
}
