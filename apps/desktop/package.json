{
  "name": "@nimiplatform/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-rust.mjs",
    "dev": "pnpm run dev:electron",
    "dev:renderer": "node scripts/ensure-dev-renderer-port.mjs -- vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:electron": "node scripts/run-electron-dev.mjs",
    "dev:macos:installed": "node ../../scripts/accept-runtime-fixed-service.mjs -- --desktop",
    "prepare:electron-native": "node scripts/prepare-electron-native.mjs",
    "build:renderer": "vite build",
    "build:electron:prepared": "pnpm run prepare:electron-native && tsc -p tsconfig.electron.json && node scripts/bundle-electron-main.mjs && node scripts/bundle-electron-preload.mjs",
    "build:electron": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run build:electron:prepared",
    "build:macos:electron:layout": "node scripts/build-macos-electron-release.mjs --layout-only",
    "build:macos:electron:dev-candidate": "node scripts/build-macos-electron-release.mjs --local-development-candidate",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:electron && pnpm run typecheck && pnpm run build:renderer",
    "lint": "eslint . --max-warnings 0",
    "test:quality": "pnpm run i18n:check && pnpm run i18n:audit",
    "test:unit:i18n": "node scripts/run-unit-tests.mjs --i18n",
    "test:unit:rest": "node scripts/run-unit-tests.mjs --rest",
    "test:unit:prepared": "pnpm run test:unit:i18n && pnpm run test:unit:rest",
    "test:unit": "node ../../scripts/with-workspace-surfaces.mjs -- pnpm run test:unit:prepared",
    "test": "pnpm run test:unit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@nimiplatform/kit": "workspace:*",
    "@nimiplatform/sdk": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "ajv": "^8.20.0",
    "i18next": "25.10.10",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1",
    "scheduler": "0.27.0",
    "socket.io-client": "^4.8.3",
    "use-sync-external-store": "^1.6.0",
    "yaml": "^2.9.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "@nimiplatform/desktop-product-control-darwin-arm64": "workspace:*",
    "@nimiplatform/desktop-product-control-win32-x64": "workspace:*"
  }
}
