#!/bin/zsh
set -euo pipefail

export PATH=/usr/bin:/bin:/usr/sbin:/sbin

if [[ "$(/usr/bin/id -u)" != "0" || "$(/usr/bin/id -ru)" != "0" ]]; then
  print -u2 -- "Nimi installer requires the macOS Installer root context"
  exit 70
fi

print -u2 -- "Nimi macOS production Runtime installation remains requirements-only and fail-closed pending native principal, SMAppService, Developer ID, notarization, and Gatekeeper admission"
exit 78
