{
  "productName": "Storybook",
  "version": "0.1.0",
  "identifier": "ai.nimi.apps.nimi.storybook",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1472",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storybook",
        "width": 1180,
        "height": 800
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
