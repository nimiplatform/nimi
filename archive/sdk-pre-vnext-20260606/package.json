{
  "name": "@nimiplatform/sdk",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nimiplatform/nimi",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./realm": {
      "types": "./dist/realm/index.d.ts",
      "default": "./dist/realm/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/browser": {
      "types": "./dist/runtime/browser.d.ts",
      "default": "./dist/runtime/browser.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./ai-provider": {
      "types": "./dist/ai-provider/index.d.ts",
      "default": "./dist/ai-provider/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./ai-app": {
      "types": "./dist/ai-app/index.d.ts",
      "default": "./dist/ai-app/index.js"
    },
    "./scope": {
      "types": "./dist/scope/index.d.ts",
      "default": "./dist/scope/index.js"
    },
    "./scope/permission": {
      "types": "./dist/scope/permission/index.d.ts",
      "default": "./dist/scope/permission/index.js"
    },
    "./runtime/agent-identity": {
      "types": "./dist/runtime/agent-identity/index.d.ts",
      "default": "./dist/runtime/agent-identity/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./platform-catalog": {
      "types": "./dist/platform-catalog/index.d.ts",
      "default": "./dist/platform-catalog/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@grpc/grpc-js": "^1.14.4",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "i18next": "^25.8.18",
    "openapi-fetch": "^0.17.0",
    "react-i18next": "^16.5.8"
  },
  "peerDependencies": {
    "react": "*"
  },
  "scripts": {
    "build": "node ../scripts/build-typescript-package.mjs --tsconfig tsconfig.build.json --out-dir dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
